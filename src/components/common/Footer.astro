---
// The theme switch lives here, not in the header: at 360px the header holds the name and the
// paths, and nothing else fits on its one line.
import ThemeToggle from './ThemeToggle.astro';
import { features, site, ui } from '../../config';

const year = new Date().getFullYear();
---

<footer class="border-border mono text-muted mt-16 border-t text-xs">
  <p class="max-w-wide mx-auto px-4 py-6">
    {`© ${year} ${site.author}`} ·{' '}
    <a href="/rss.xml" class="hover:text-foreground">
      {ui.rss}
    </a>
    {/* The theme credit. Remove it if you like: the MIT license does not require it. */}
    {' · '}
    <a href="https://ondelva.com/themes/monoline" rel="nofollow" class="hover:text-foreground">
      Monoline
    </a>{' '}
    theme by ondelva
    {features.darkMode && (
      <>
        {' · '}
        <ThemeToggle />
      </>
    )}
  </p>
</footer>
