---
import { nav, site } from '../../config';

interface Props {
  /** On the home page the site name is the page's h1, and not a link to itself. */
  home?: boolean;
}
const { home = false } = Astro.props;
const path = Astro.url.pathname;
---

<header class="bg-background border-border sticky top-0 z-10 border-b">
  <div class="mono max-w-wide mx-auto flex flex-wrap items-baseline gap-x-[1ch] gap-y-1 px-4 py-3 text-sm sm:gap-x-[2ch]">
    {home ? (
      <h1 class="font-medium whitespace-nowrap">{site.name}</h1>
    ) : (
      <a href="/" class="font-medium whitespace-nowrap no-underline hover:underline">
        {site.name}
      </a>
    )}
    <nav aria-label="Main" class="ms-auto">
      <ul class="flex gap-x-[1ch] sm:gap-x-[2ch]">
        {nav.header.map(({ label, href }) => {
          const current = path === href || path.startsWith(`${href}/`);
          return (
            <li>
              <a
                href={href}
                aria-current={current ? 'page' : undefined}
                class:list={[
                  'no-underline hover:underline',
                  current ? 'text-foreground' : 'text-muted',
                ]}
              >
                /{label}
              </a>
            </li>
          );
        })}
      </ul>
    </nav>
  </div>
</header>
