---
// The table of notes: one line per note, the columns of a well-kept index file.
// Home and /notes share it. Widths are in ch of the mono face, so dates line up.
import { isoDate, notePath, type Note } from '../../lib/notes';
import { ui } from '../../config';

interface Props {
  notes: Note[];
  /** Read out before the table, e.g. "Recent notes". */
  label: string;
  /** Group by year: a year row heads each group and the dates drop the year it already says. */
  years?: boolean;
}
const { notes, label, years = false } = Astro.props;

const groups: [string, Note[]][] = [];
for (const note of notes) {
  const key = years ? String(note.data.date.getUTCFullYear()) : '';
  if (groups.at(-1)?.[0] === key) groups.at(-1)![1].push(note);
  else groups.push([key, [note]]);
}
---

<table class="mono w-full border-collapse text-sm" aria-label={label}>
  <thead>
    <tr class="text-muted border-foreground border-b text-xs">
      <th scope="col" class="pb-2 text-start font-normal">
        {ui.table.date}
      </th>
      <th scope="col" class="pb-2 text-start font-normal">
        {ui.table.note}
      </th>
      <th scope="col" class="pb-2 text-start font-normal max-sm:hidden">
        {ui.table.tag}
      </th>
    </tr>
  </thead>
  {groups.map(([year, group]) => (
    <tbody>
      {year && (
        <tr>
          <th scope="rowgroup" colspan="3" class="pt-8 pb-2 text-start font-medium">
            {year}
          </th>
        </tr>
      )}
      {group.map((note) => {
        const tag = note.data.tags[0];
        return (
          <tr class="border-border border-b">
            <td class="text-muted py-2.5 pe-[2ch] align-baseline whitespace-nowrap">
              <time datetime={isoDate(note.data.date)}>
                {years ? isoDate(note.data.date).slice(5) : isoDate(note.data.date)}
              </time>
            </td>
            <td class="font-prose py-2.5 pe-[2ch] align-baseline text-base">
              <a href={notePath(note)} class="no-underline hover:underline">
                {note.data.title}
              </a>
            </td>
            <td class="text-muted py-2.5 align-baseline whitespace-nowrap max-sm:hidden">
              {tag && `#${tag}`}
            </td>
          </tr>
        );
      })}
    </tbody>
  ))}
</table>
