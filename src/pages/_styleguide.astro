---
// Dev-only route (injected in astro.config.mjs). Never built for production.
// This is the page to look at in light, dark, and 360px when tokens change.
import Base from '../layouts/Base.astro';
import ThemeToggle from '../components/common/ThemeToggle.astro';

const colors = [
  '--background',
  '--surface',
  '--foreground',
  '--muted',
  '--border',
  '--primary',
  '--primary-hover',
  '--on-primary',
];
const sizes = ['text-xs', 'text-sm', 'text-base', 'text-lg', 'text-xl', 'text-2xl', 'text-3xl'];
---

<Base title="Styleguide" noindex>
  <div class="mx-auto max-w-wide space-y-12 px-4 py-12">
    <header class="flex items-baseline justify-between gap-4">
      <h1 class="text-2xl font-bold">Styleguide</h1>
      <ThemeToggle />
    </header>

    <section>
      <h2 class="font-ui text-lg font-semibold">Color</h2>
      <ul class="mt-4 grid grid-cols-[repeat(auto-fill,minmax(10rem,1fr))] gap-3">
        {colors.map((name) => (
          <li class="border-border border p-3">
            <span
              class="block h-10 w-full border border-border"
              style={`background: var(${name})`}
            />
            <code class="font-mono text-xs">{name}</code>
          </li>
        ))}
      </ul>
      <p class="text-muted mt-3 text-sm">
        Contrast is checked by <code class="font-mono">pnpm check:contrast</code>, not by eye.
      </p>
    </section>

    <section>
      <h2 class="font-ui text-lg font-semibold">Type scale</h2>
      <dl class="mt-4 space-y-2">
        {sizes.map((size) => (
          <div class="flex items-baseline gap-4">
            <dt class="font-mono text-muted w-24 shrink-0 text-xs">{size}</dt>
            <dd class={size}>The quick brown fox jumps over the lazy dog</dd>
          </div>
        ))}
      </dl>
    </section>

    <section>
      <h2 class="font-ui text-lg font-semibold">Signature: the source gutter</h2>
      <p class="text-muted mt-2 max-w-content text-sm">
        Each block shows the Markdown that made it. Wide screens: in a gutter left of the text.
        Below 48rem: a prefix on the block's first line.
      </p>
      <article class="note-column mt-8">
        <p class="mono text-muted text-xs">notes / 2026-09-02 / #process</p>
        <h1 class="mono mt-3 text-2xl font-medium">One file per project, kept for years</h1>
        <p class="mono text-muted mt-2 text-xs">4 min · 812 words · updated 2026-09-05</p>
        <div class="note-body mt-8">
          <p>
            I keep one plain file per project and never start a second one. It holds the brief, the
            arguments I lost, and the decisions I would otherwise relitigate in March.
            <sup>
              <a href="#fn1" data-footnote-ref>
                1
              </a>
            </sup>
          </p>
          <h2 data-md="##">What goes in</h2>
          <p>Everything I would be annoyed to rediscover, in the order it happened.</p>
          <ul>
            <li data-md="-">the brief, pasted as it arrived</li>
            <li data-md="-">
              every <a href="#">decision</a>, with the date and who was in the room
            </li>
            <li data-md="-">the questions nobody answered</li>
          </ul>
          <h3 data-md="###">What stays out</h3>
          <ol>
            <li data-md="1.">Screenshots. They rot faster than the text around them.</li>
            <li data-md="2.">Anything I would not show the client.</li>
          </ol>
          <blockquote data-md=">">
            <p>A decision you cannot find is a decision you will make again.</p>
          </blockquote>
          <pre data-md="```"><code>## 2026-09-05
- shipped v2 of the pricing page
- left the old FAQ up until legal signs off</code></pre>
          <hr data-md="---" />
          <section class="footnotes">
            <ol>
              <li id="fn1" data-md="[^1]">
                <p>March is when every project I have worked on gets its second kickoff.</p>
              </li>
            </ol>
          </section>
        </div>
      </article>
    </section>

    <section>
      <h2 class="font-ui text-lg font-semibold">Index</h2>
      <table class="mono mt-4 w-full max-w-[52rem] border-collapse text-sm">
        <thead>
          <tr class="text-muted border-foreground border-b text-xs">
            <th class="pb-2 text-start font-normal">date</th>
            <th class="pb-2 text-start font-normal">note</th>
            <th class="pb-2 text-start font-normal max-sm:hidden">tag</th>
          </tr>
        </thead>
        <tbody>
          {[
            ['2026-10-11', 'Critique is a format, not a mood', '#critique'],
            ['2026-09-27', 'Writing the brief twice', '#process'],
            ['2026-09-02', 'One file per project, kept for years', '#process'],
            ['2026-08-15', 'What a year of notes taught me', '#habits'],
          ].map(([d, t, tag]) => (
            <tr class="border-border border-b">
              <td class="text-muted w-[12ch] py-2.5 align-baseline">{d}</td>
              <td class="font-prose py-2.5 pe-[2ch] align-baseline text-base">
                <a href="#" class="no-underline hover:underline">
                  {t}
                </a>
              </td>
              <td class="text-muted w-[11ch] py-2.5 align-baseline max-sm:hidden">{tag}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </section>

    <section>
      <h2 class="font-ui text-lg font-semibold">Body copy</h2>
      <div class="max-w-content mt-4">
        <p>
          Body text runs at the measure set by <code class="font-mono">--content-width</code>. It
          carries <a href="#">an inline link</a>, <em>emphasis</em>,{' '}
          <strong>strong emphasis</strong>, and <code class="font-mono">inline code</code>.
        </p>
      </div>
    </section>
  </div>
</Base>
