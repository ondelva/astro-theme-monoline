---
// A wrong address: say so, then offer the way back in: the latest notes.
import Base from '../layouts/Base.astro';
import NotesTable from '../components/notes/NotesTable.astro';
import { getNotes } from '../lib/notes';
import { ui } from '../config';

const recent = (await getNotes()).slice(0, 5);
---

<Base title="Page not found" noindex>
  <div class="max-w-wide mx-auto px-4 pt-12">
    <h1 class="mono text-2xl font-medium">404</h1>
    <p class="text-muted mt-4">{ui.notFound}</p>
    {recent.length > 0 && (
      <section class="mt-10">
        <h2 class="mono text-muted mb-2 text-xs font-normal">{ui.recent}</h2>
        <NotesTable notes={recent} label={ui.recentNotes} />
      </section>
    )}
    <p class="mono mt-6 text-sm">
      <a href="/notes">{ui.allNotesLink}</a>
    </p>
  </div>
</Base>
