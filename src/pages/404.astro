---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found" noindex>
  <div class="max-w-wide mx-auto px-4 pt-12">
    <h1 class="mono text-2xl font-medium">404</h1>
    <p class="text-muted mt-4">There is no note at this address.</p>
    <p class="mono mt-6 text-sm">
      <a href="/notes">all notes →</a>
    </p>
  </div>
</Base>
