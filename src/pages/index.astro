---
import Base from '../layouts/Base.astro';
import NotesTable from '../components/notes/NotesTable.astro';
import { getNotes } from '../lib/notes';
import { monoline, site } from '../config';

const notes = await getNotes();
const recent = notes.slice(0, monoline.homeCount);
---

<Base description={site.description} home>
  <div class="max-w-wide mx-auto px-4 pt-12">
    {site.lede && <p class="max-w-content text-lg leading-relaxed text-pretty">{site.lede}</p>}
    {recent.length > 0 && (
      <section class="mt-12">
        <NotesTable notes={recent} label="Recent notes" />
        {notes.length > recent.length && (
          <p class="mono mt-4 text-sm">
            <a href="/notes" class="no-underline hover:underline">
              all {notes.length} notes →
            </a>
          </p>
        )}
      </section>
    )}
  </div>
</Base>
