---
import Base from '../../layouts/Base.astro';
import NotesTable from '../../components/notes/NotesTable.astro';
import { getNotes } from '../../lib/notes';
import { ui } from '../../config';

const notes = await getNotes();
---

<Base title="Notes" description={ui.notesDescription(notes.length)}>
  <div class="max-w-wide mx-auto px-4 pt-12">
    <h1 class="mono flex items-baseline gap-[2ch] text-2xl font-medium">
      {ui.notes} <span class="text-muted text-sm font-normal">{notes.length}</span>
    </h1>
    {notes.length > 0 ? (
      <div class="mt-4">
        <NotesTable notes={notes} label={ui.allNotes} years />
      </div>
    ) : (
      <p class="text-muted mt-6">{ui.nothingYet}</p>
    )}
  </div>
</Base>
