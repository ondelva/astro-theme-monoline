---
// Markdown pages in src/pages (about.md, now.md): the note column and body. A page with an
// `updated` date in its front matter shows it under the title.
import Base from './Base.astro';
import { isoDate } from '../lib/text';
import { monoline } from '../config';

interface Props {
  frontmatter: { title: string; description?: string; updated?: string };
}
const { title, description, updated } = Astro.props.frontmatter;
// YAML dates arrive as Date objects, quoted ones as strings.
const date = updated ? new Date(updated) : undefined;
---

<Base title={title} description={description}>
  <article class="max-w-wide mx-auto px-4 pt-10">
    <div class="note-column">
      <h1 class="mono text-2xl leading-snug font-medium">{title}</h1>
      {date && (
        <p class="mono text-muted mt-2 text-xs">
          updated <time datetime={isoDate(date)}>{isoDate(date)}</time>
        </p>
      )}
      <div class:list={['note-body mt-8', !monoline.gutter && 'no-gutter']}>
        <slot />
      </div>
    </div>
  </article>
</Base>
